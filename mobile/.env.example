# Pocket Ledger Mobile Environment Variables
# -------------------------------------------------------------
# Configuration for connecting to the existing FastAPI backend:
#
# 1. Android Emulator:
#    Use http://10.0.2.2:8000 (Android maps 10.0.2.2 to the host machine's localhost)
#
# 2. Physical Android or iOS device (on same Wi-Fi):
#    Use http://<YOUR_LOCAL_IP>:8000 (e.g., http://192.168.1.5:8000)
#
# 3. iOS Simulator or Web:
#    Use http://localhost:8000
# -------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
