# ==============================================================================
# Pocket Ledger - Development Environment Variables
# ==============================================================================

# Backend Database (PostgreSQL or SQLite)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/expense_tracker
# Example for SQLite: sqlite:///data/expenses.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker

# Backend Server Configuration
PORT=9000
HOST=0.0.0.0

# Mobile Configuration (Set LAN IP of PC when running on physical device)
EXPO_PUBLIC_API_URL=http://localhost:9000
